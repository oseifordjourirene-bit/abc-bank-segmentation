# ABC Bank drift model - live /predict API (Hugging Face Spaces / Docker Compose)
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=7860 \
    EXPLANATION_DB=/app/logs/explanations.db
WORKDIR /app
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt
# Only what scoring needs: API code, the model package the saved pipelines refer to, model files
COPY api/ api/
COPY src/__init__.py src/config.py src/
COPY src/model/ src/model/
COPY models/*.joblib models/*.json models/
# Hugging Face runs containers as user 1000; the explanation store must be writable
RUN useradd --uid 1000 --create-home api && mkdir -p /app/logs && chown -R api /app
USER api
EXPOSE 7860
HEALTHCHECK CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:${PORT}/health')"
CMD ["sh", "-c", "uvicorn api.main:app --host 0.0.0.0 --port ${PORT}"]
